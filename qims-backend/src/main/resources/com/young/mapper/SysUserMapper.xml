<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.young.mapper.SysUserMapper">

    <resultMap id="BaseResultMap" type="com.young.pojo.SysUser">
        <id column="id" property="id" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="real_name" property="realName" />
        <result column="role_id" property="roleId" />
        <result column="phone" property="phone" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, real_name, role_id, phone, status, create_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM sys_user
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM sys_user
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (
            username, password, real_name, role_id, phone, status, create_time
        ) VALUES (
            #{username}, #{password}, #{realName}, #{roleId}, #{phone}, #{status}, #{createTime}
        )
    </insert>

    <update id="update">
        UPDATE sys_user
        <set>
            <if test="username != null"> username = #{username}, </if>
            <if test="password != null"> password = #{password}, </if>
            <if test="realName != null"> real_name = #{realName}, </if>
            <if test="roleId != null"> role_id = #{roleId}, </if>
            <if test="phone != null"> phone = #{phone}, </if>
            <if test="status != null"> status = #{status}, </if>
            <if test="createTime != null"> create_time = #{createTime}, </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>

</mapper>
