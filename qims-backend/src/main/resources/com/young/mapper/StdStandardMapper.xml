<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.young.mapper.StdStandardMapper">

    <resultMap id="BaseResultMap" type="com.young.pojo.StdStandard">
        <id column="id" property="id" />
        <result column="standard_code" property="standardCode" />
        <result column="standard_name" property="standardName" />
        <result column="standard_category" property="standardCategory" />
        <result column="product_category" property="productCategory" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="Base_Column_List">
        id, standard_code, standard_name, standard_category, product_category, status, create_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM std_standard
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM std_standard
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO std_standard (
            standard_code, standard_name, standard_category, product_category, status, create_time
        ) VALUES (
            #{standardCode}, #{standardName}, #{standardCategory}, #{productCategory}, #{status}, #{createTime}
        )
    </insert>

    <update id="update">
        UPDATE std_standard
        <set>
            <if test="standardCode != null"> standard_code = #{standardCode}, </if>
            <if test="standardName != null"> standard_name = #{standardName}, </if>
            <if test="standardCategory != null"> standard_category = #{standardCategory}, </if>
            <if test="productCategory != null"> product_category = #{productCategory}, </if>
            <if test="status != null"> status = #{status}, </if>
            <if test="createTime != null"> create_time = #{createTime}, </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM std_standard WHERE id = #{id}
    </delete>

</mapper>
